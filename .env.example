NEXT_PUBLIC_SITE_URL=http://localhost:3000
# GitHub project Pages: /your-repository (empty for a custom domain or owner.github.io).
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase Edge Function secret and local provisioning scripts only. Never a GitHub Pages variable.
SUPABASE_SECRET_KEY=
# Light tiles. Set a production tile service appropriate for your traffic.
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
NEXT_PUBLIC_MAP_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright
# Google Maps: Share > Embed a map > copy only the iframe src URL (satellite selected).
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=
APK_MAX_BYTES=52428800
# Cash/manual settlement only. No online gateway is implemented or claimed.
PAYMENT_MODE=cash
# Optional local integration tests only. Never use production keys/data here.
TEST_SUPABASE_URL=
TEST_SUPABASE_PUBLISHABLE_KEY=
TEST_SUPABASE_SECRET_KEY=
TEST_INBOX_URL=http://127.0.0.1:54324
# Optional real developer test APK, used only against an isolated local backend.
TEST_APK_PATH=
