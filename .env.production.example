# Copy to .env.production.local (ignored) for production builds and deploys.
# Only NEXT_PUBLIC_* values belong in the browser bundle.
# Never add SUPABASE_SECRET_KEY, service-role keys or SMTP passwords here.
NEXT_PUBLIC_SITE_URL=https://serbisyogo.sg-team.workers.dev
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
NEXT_PUBLIC_MAP_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=
