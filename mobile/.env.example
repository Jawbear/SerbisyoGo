# Only public project values belong in a mobile bundle. Never use a service key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Website used for email verification, password recovery and policy pages.
EXPO_PUBLIC_SITE_URL=https://serbisyogo.sg-team.workers.dev

# Optional street-map tile provider. Only public service-area pins are plotted.
EXPO_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
EXPO_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors
EXPO_PUBLIC_MAP_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright
# Set to 1 for an isolated testing APK to disable public update lookups.
EXPO_PUBLIC_DISABLE_RELEASE_FEED=0
