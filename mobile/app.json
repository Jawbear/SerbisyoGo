{
  "expo": {
    "name": "SerbisyoGo",
    "slug": "serbisyogo-mobile",
    "version": "0.5.5",
    "scheme": "serbisyogo",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0f0e",
    "icon": "./assets/logo.png",
    "android": {
      "package": "com.serbisyogo.mobile",
      "versionCode": 13,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/launcher-foreground.png",
        "backgroundColor": "#000000",
        "monochromeImage": "./assets/launcher-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "android": {
            "image": "./assets/logo.png",
            "backgroundColor": "#000000",
            "resizeMode": "contain",
            "imageWidth": 168
          }
        }
      ]
    ]
  }
}
