{
  "name": "serbisyogo-mobile",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "export:web": "expo export --platform web --max-workers 2",
    "export:android": "expo export --platform android --max-workers 2 --output-dir ../.cache/mobile-android-export",
    "test": "node --test tests/domain.test.mjs tests/apk-signature.test.mjs tests/updates.test.mjs",
    "test:e2e": "playwright test --config playwright.config.mjs",
    "lint": "eslint App.js index.js src tests scripts --config eslint.config.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/native-stack": "^7.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~55.0.0",
    "expo-crypto": "~55.0.19",
    "expo-document-picker": "~55.0.17",
    "expo-font": "~55.0.8",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.22",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
