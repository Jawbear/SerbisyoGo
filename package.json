{
  "name": "serbisyogo-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/domain.test.ts tests/development-seed.test.mjs tests/http.test.ts",
    "test:e2e": "playwright test",
    "test:db": "supabase test db",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "node scripts/generate-types.mjs",
    "seed:demo": "node --env-file=.env.local scripts/seed-demo.mjs",
    "seed:development": "node --env-file=.env.local scripts/seed-development.mjs",
    "check:development": "node --env-file=.env.local scripts/check-development.mjs",
    "admin:provision": "node --env-file=.env.local scripts/provision-admin.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "@fontsource/plus-jakarta-sans": "^5.2.6",
    "@tailwindcss/postcss": "^4.1.13",
    "tailwindcss": "^4.1.13",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "recharts": "^3.1.2",
    "server-only": "^0.0.1",
    "zod": "^4.1.5",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.18.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "^16.0.0",
    "supabase": "^2.39.2",
    "typescript": "^5.9.2"
  },
  "engines": { "node": ">=22.19.0" }
}
